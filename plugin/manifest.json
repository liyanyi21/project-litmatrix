  "description": "按 Zotero 分类建立项目独立的中文文献矩阵，支持项目字段、AI 总结、CSV/TSV 导入导出和原文跳转。",
  "author": "liyanyi; based on LitMatrix by bapungiri",
  "icons": {
    "48": "content/icon.svg",
    "96": "content/icon.svg"
  },
  "applications": {
    "zotero": {
      "id": "project-litmatrix@liyanyi.local",
      "update_url": "https://127.0.0.1:0/project-litmatrix/updates.json",
      "strict_min_version": "7.0",
      "strict_max_version": "11.*"
    }
  },
  "homepage_url": "https://github.com/liyanyi21/research-grid"
}
